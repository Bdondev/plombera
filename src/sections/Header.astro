---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const links = [
	{ label: 'Home', href: '/', chevron: true },
	{ label: 'About', href: '/#about' },
	{ label: 'Services', href: '/#services', chevron: true },
	{ label: 'Blog', href: '/#blog', chevron: true },
	{ label: 'Contact', href: '/#contact' },
];
---

<header class="site-header">
	<div class="header-shell">
		<a class="brand" href="/" aria-label="Plombera home">
			<Image src={logo} alt="Plombera" width={207} height={69} loading="eager" />
		</a>

		<nav class="desktop-nav" aria-label="Main navigation">
			<ul>
				{links.map((link) => (
					<li>
						<a href={link.href} aria-current={link.href === '/' ? 'page' : undefined}>
							{link.label}
							{link.chevron && <span class="chevron" aria-hidden="true"></span>}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<a class="phone" href="tel:+15145550123" aria-label="Call Plombera at (514) 555-0123">
			<span class="phone-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
					<path d="M7.4 3.4 10 6.1 8.4 8.7a16 16 0 0 0 6.9 6.9l2.6-1.6 2.7 2.6-1.5 3.3c-.3.7-1.1 1-1.8.9C9.6 19.7 4.3 14.4 3.2 6.7c-.1-.7.2-1.5.9-1.8l3.3-1.5Z" />
				</svg>
			</span>
			<span class="phone-copy"><span>Call Or Chat</span><strong>(514) 555-0123</strong></span>
		</a>

		<button class="language-toggle" type="button" data-language-toggle aria-label="Switch to French" aria-pressed="false">
			<span data-language-label>FR</span>
		</button>

		<details class="mobile-menu">
			<summary aria-label="Navigation menu">
				<span class="menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
			</summary>
			<nav aria-label="Mobile navigation">
				<ul>
					{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
					<li><a href="tel:+15145550123">Call (514) 555-0123</a></li>
				</ul>
			</nav>
		</details>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		z-index: 20;
		top: clamp(18px, 2.4vw, 35px);
		left: 0;
		width: 100%;
		margin-bottom: -84px;
		padding-inline: var(--spacing-container);
	}
	.header-shell {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		width: min(100%, 1170px);
		min-height: 84px;
		margin-inline: auto;
		padding: 8px 17px 8px 22px;
		border-radius: 999px;
		background: rgb(255 255 255 / 94%);
		box-shadow: 0 8px 32px rgb(16 43 99 / 8%);
	}
	.brand { display: flex; flex: none; align-items: center; }
	.brand img { display: block; width: clamp(156px, 14.4vw, 207px); height: auto; }
	.desktop-nav { transform: translateX(-55px); }
	.desktop-nav ul, .mobile-menu ul { display: flex; align-items: center; gap: clamp(14px, 1.55vw, 24px); margin: 0; padding: 0; list-style: none; }
	.desktop-nav a { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; color: var(--color-plombera-navy-950); font-size: 15px; font-weight: 500; text-decoration: none; white-space: nowrap; }
	.desktop-nav a:hover, .mobile-menu a:hover { color: var(--color-plombera-blue-600); }
	.chevron { display: inline-block; width: 7px; height: 7px; transform: translateY(-2px) rotate(45deg); border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; }
	.phone { display: inline-flex; flex: none; align-items: center; gap: 11px; color: var(--color-plombera-navy-950); text-decoration: none; }
	.phone-icon { display: grid; width: 54px; height: 54px; place-items: center; border-radius: 50%; background: var(--color-plombera-yellow-400); }
	.phone-icon svg { width: 25px; height: 25px; }
	.phone-copy { display: grid; gap: 3px; white-space: nowrap; }
	.phone-copy span { color: var(--color-plombera-muted); font-size: 13px; }
	.phone-copy strong { font-size: 15px; font-weight: 800; }
	.language-toggle {
		display: inline-grid;
		width: 40px;
		height: 40px;
		flex: none;
		place-items: center;
		border: 1px solid rgb(16 43 99 / 18%);
		border-radius: 50%;
		background: white;
		color: var(--color-plombera-navy-950);
		font-size: 11px;
		font-weight: 800;
		cursor: pointer;
	}
	.language-toggle:hover { border-color: var(--color-plombera-blue-600); color: var(--color-plombera-blue-600); }
	.mobile-menu { display: none; }
	a:focus-visible, summary:focus-visible { outline: 3px solid var(--color-plombera-blue-600); outline-offset: 4px; }
	@media (max-width: 1050px) {
		.site-header { margin-bottom: -70px; }
		.header-shell { min-height: 70px; }
		.desktop-nav { display: none; }
		.mobile-menu { display: block; position: relative; margin-left: auto; }
		.mobile-menu summary { display: grid; width: 44px; height: 44px; place-items: center; border-radius: 50%; color: var(--color-plombera-navy-950); cursor: pointer; list-style: none; }
		.mobile-menu summary::-webkit-details-marker { display: none; }
		.menu-bars { position: relative; display: block; width: 22px; height: 19px; }
		.menu-bars span { position: absolute; left: 0; display: block; width: 22px; height: 2px; border-radius: 2px; background: currentColor; transform-origin: center; transition: transform 180ms ease, opacity 180ms ease; }
		.menu-bars span:nth-child(1) { top: 1px; }
		.menu-bars span:nth-child(2) { top: 8px; }
		.menu-bars span:nth-child(3) { top: 15px; }
		.mobile-menu[open] .menu-bars span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
		.mobile-menu[open] .menu-bars span:nth-child(2) { opacity: 0; }
		.mobile-menu[open] .menu-bars span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
		.mobile-menu nav { position: absolute; top: calc(100% + 17px); right: -14px; width: min(300px, calc(100vw - 40px)); padding: 12px; border-radius: 18px; background: white; box-shadow: var(--shadow-float); }
		.mobile-menu ul { display: grid; gap: 0; }
		.mobile-menu a { display: block; padding: 11px 12px; border-radius: 8px; color: var(--color-plombera-navy-950); font-weight: 600; text-decoration: none; }
	}
	@media (max-width: 600px) {
		.site-header { top: 16px; margin-bottom: -62px; padding-inline: 16px; }
		.header-shell { min-height: 62px; padding: 7px 10px 7px 16px; }
		.brand img { width: 143px; }
		.phone { margin-left: auto; }
		.language-toggle { width: 38px; height: 38px; }
		.phone-icon { width: 42px; height: 42px; }
		.phone-icon svg { width: 22px; height: 22px; }
		.phone-copy { display: none; }
		.mobile-menu { margin-left: 0; }
	}
	@media (prefers-reduced-motion: reduce) {
		.menu-bars span { transition-duration: 0.01ms; }
	}
</style>
