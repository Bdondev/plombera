---
import { Image } from 'astro:assets';
import plumbingPhoto from '../assets/portfolio.png';
---

<section class="emergency-banner" aria-labelledby="emergency-banner-title">
	<Image
		class="emergency-photo"
		src={plumbingPhoto}
		alt=""
		width={1672}
		height={941}
		loading="lazy"
	/>
	<div class="emergency-blue-shape" aria-hidden="true"></div>
	<div class="emergency-bottom-blue" aria-hidden="true"></div>
	<div class="emergency-bottom-navy" aria-hidden="true"></div>

	<div class="emergency-content">
		<h2 id="emergency-banner-title">Plumbing Emergency We’re Ready 24/7 To Fix It Fast!</h2>
		<p>When a plumbing problem needs attention, our team can help you find the right next step.</p>
		<div class="emergency-actions">
			<a class="emergency-cta" href="/#contact">Contact Us Today</a>
			<a class="emergency-phone" href="tel:+12343454574" aria-label="Call Plombera at (234) 345-4574">
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
					<path d="M7.4 3.4 10 6.1 8.4 8.7a16 16 0 0 0 6.9 6.9l2.6-1.6 2.7 2.6-1.5 3.3c-.3.7-1.1 1-1.8.9C9.6 19.7 4.3 14.4 3.2 6.7c-.1-.7.2-1.5.9-1.8l3.3-1.5Z" />
				</svg>
				<span>(234) 345-4574</span>
			</a>
		</div>
	</div>
</section>

<style>
	.emergency-banner {
		position: relative;
		isolation: isolate;
		min-height: clamp(283px, 20vw, 360px);
		overflow: hidden;
		background: var(--color-plombera-blue-600);
		color: white;
	}

	.emergency-photo {
		position: absolute;
		z-index: -4;
		inset: 0 0 0 34%;
		width: 66%;
		height: 100%;
		object-fit: cover;
		object-position: center 56%;
	}

	.emergency-blue-shape {
		position: absolute;
		z-index: -3;
		inset: 0 auto 0 0;
		width: 63%;
		background: linear-gradient(105deg, #1558d6 0%, #1c61dc 55%, rgb(37 99 235 / 72%) 100%);
		clip-path: polygon(0 0, 86% 0, 100% 100%, 0 100%);
	}

	.emergency-bottom-blue {
		position: absolute;
		z-index: -2;
		bottom: 0;
		left: 0;
		width: 50%;
		height: 30%;
		background: var(--color-plombera-blue-600);
		clip-path: polygon(0 0, 68% 0, 100% 100%, 0 100%);
	}

	.emergency-bottom-navy {
		position: absolute;
		z-index: -1;
		right: 0;
		bottom: 0;
		width: 27%;
		height: 45%;
		background: var(--color-plombera-navy-950);
		clip-path: polygon(100% 0, 100% 100%, 0 100%);
	}

	.emergency-content {
		position: relative;
		z-index: 1;
		display: flex;
		width: min(calc(100% - 2.5rem), 1170px);
		min-height: inherit;
		margin-inline: auto;
		flex-direction: column;
		justify-content: center;
		padding-block: 44px;
	}

	.emergency-content h2 {
		max-width: 530px;
		margin: 0;
		font-size: clamp(31px, 3.15vw, 48px);
		line-height: 0.96;
		letter-spacing: -0.04em;
	}

	.emergency-content p {
		max-width: 475px;
		margin: 17px 0 0;
		color: rgb(255 255 255 / 88%);
		font-size: 14px;
		line-height: 1.35;
	}

	.emergency-actions {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-top: 22px;
	}

	.emergency-cta,
	.emergency-phone {
		display: inline-flex;
		min-height: 43px;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-pill);
		font-size: 14px;
		font-weight: 800;
		text-decoration: none;
		transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
	}

	.emergency-cta {
		padding-inline: 19px;
		background: var(--color-plombera-yellow-400);
		box-shadow: 0 2px 0 var(--color-plombera-navy-950);
		color: var(--color-plombera-navy-950);
	}

	.emergency-cta:hover { background: var(--color-plombera-yellow-300); transform: translateY(-1px); }

	.emergency-phone {
		gap: 8px;
		padding-inline: 17px;
		background: white;
		box-shadow: 0 2px 0 rgb(16 43 99 / 35%);
		color: var(--color-plombera-navy-950);
	}

	.emergency-phone:hover { background: #eef3ff; transform: translateY(-1px); }
	.emergency-phone svg { width: 17px; height: 17px; }

	.emergency-cta:focus-visible,
	.emergency-phone:focus-visible {
		outline: 3px solid white;
		outline-offset: 4px;
	}

	@media (max-width: 800px) {
		.emergency-banner { min-height: 360px; }
		.emergency-photo { inset: 0; width: 100%; object-position: 67% center; }
		.emergency-blue-shape { width: 100%; background: linear-gradient(90deg, rgb(21 88 214 / 96%), rgb(21 88 214 / 78%) 72%, rgb(21 88 214 / 48%)); clip-path: none; }
		.emergency-content { padding-block: 52px; }
		.emergency-content h2 { max-width: 540px; font-size: clamp(34px, 6vw, 46px); }
	}

	@media (max-width: 600px) {
		.emergency-banner { min-height: 500px; }
		.emergency-content { width: min(calc(100% - 2rem), 1170px); justify-content: flex-start; padding-block: 56px 48px; }
		.emergency-content h2 { max-width: 340px; font-size: 38px; }
		.emergency-content p { max-width: 320px; margin-top: 18px; font-size: 14px; }
		.emergency-actions { align-items: stretch; flex-direction: column; gap: 12px; width: min(100%, 270px); margin-top: 25px; }
		.emergency-cta, .emergency-phone { width: 100%; }
		.emergency-bottom-blue { width: 68%; height: 22%; }
		.emergency-bottom-navy { width: 38%; height: 20%; }
	}

	@media (prefers-reduced-motion: reduce) {
		.emergency-cta, .emergency-phone { transition: none; }
	}
</style>
