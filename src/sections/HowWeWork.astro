---
const steps = [
	{
		number: '01',
		title: 'Schedule Your Service',
		description: 'Book online or call our friendly team. We quickly confirm your appointment and provide an estimated arrival time.',
	},
	{
		number: '02',
		title: 'Expert Assessment',
		description: 'Our licensed plumbers arrive on time and inspect your plumbing issue carefully to determine the most efficient.',
	},
	{
		number: '03',
		title: 'Fast & Reliable Repair',
		description: 'We fix leaks, clogs, install new systems using high quality materials & professional techniques getting the job done.',
	},
	{
		number: '04',
		title: 'Follow-Up & Satisfaction',
		description: 'We clean up after every job, test the system, and ensure you’re completely satisfied our team is always available.',
	},
];
---

<section id="how-we-work" class="process-section" aria-labelledby="process-title">
	<div class="process-container">
		<div class="process-intro">
			<p class="eyebrow">How We Work</p>
			<h2 id="process-title">The Way We Work</h2>
			<p class="intro-copy">Whether it’s a small leak or full installation, we use high quality materials and professional techniques to ensure lasting results. After every job, we clean up, test system.</p>
		</div>

		<ol class="process-list">
			{steps.map((step) => (
				<li class="process-step">
					<span class="step-number" aria-hidden="true">{step.number}</span>
					<div class="step-content">
						<h3>{step.title}</h3>
						<p>{step.description}</p>
					</div>
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	.process-section {
		background: white;
		color: var(--color-plombera-navy-950);
	}

	.process-container {
		display: grid;
		grid-template-columns: minmax(0, 0.78fr) minmax(0, 1fr);
		gap: clamp(72px, 8vw, 120px);
		width: min(calc(100% - 2.5rem), 1170px);
		margin-inline: auto;
		padding-block: clamp(86px, 8vw, 128px) clamp(92px, 8vw, 128px);
	}

	.process-intro {
		align-self: start;
	}

	.eyebrow {
		display: inline-flex;
		width: fit-content;
		margin: 0 0 26px;
		padding: 6px 14px 5px;
		border: 1px solid var(--color-plombera-navy-950);
		border-radius: var(--radius-pill);
		font-family: var(--font-display);
		font-size: 15px;
		font-weight: 700;
		line-height: 1;
		text-transform: uppercase;
	}

	.process-intro h2 {
		max-width: 520px;
		margin: 0;
		font-size: clamp(42px, 4vw, 60px);
		line-height: 0.98;
		letter-spacing: -0.035em;
	}

	.intro-copy {
		max-width: 560px;
		margin: 28px 0 0;
		color: var(--color-plombera-muted);
		font-size: 18px;
		line-height: 1.42;
	}

	.process-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.process-step {
		display: grid;
		grid-template-columns: 92px minmax(0, 1fr);
		gap: 22px;
		align-items: center;
		min-height: 176px;
		padding-block: 28px;
		border-top: 1px solid var(--color-plombera-line);
	}

	.process-step:last-child {
		border-bottom: 1px solid var(--color-plombera-line);
	}

	.step-number {
		display: grid;
		width: 92px;
		height: 92px;
		place-items: center;
		border-radius: 18px;
		background: var(--color-plombera-surface);
		font-family: var(--font-display);
		font-size: 33px;
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.step-content h3 {
		margin: 0 0 13px;
		font-size: clamp(22px, 1.75vw, 30px);
		line-height: 1;
		letter-spacing: -0.025em;
	}

	.step-content p {
		max-width: 650px;
		margin: 0;
		color: var(--color-plombera-muted);
		font-size: 18px;
		line-height: 1.35;
	}

	@media (max-width: 900px) {
		.process-container { grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr); gap: 56px; }
		.process-step { grid-template-columns: 72px minmax(0, 1fr); gap: 16px; min-height: 150px; }
		.step-number { width: 72px; height: 72px; font-size: 28px; border-radius: 15px; }
		.step-content p { font-size: 16px; }
	}

	@media (max-width: 700px) {
		.process-container {
			display: block;
			padding-block: 72px 80px;
		}
		.process-intro { margin-bottom: 54px; }
		.process-intro h2 { font-size: clamp(40px, 11vw, 54px); }
		.intro-copy { margin-top: 22px; font-size: 16px; }
		.process-step { min-height: 0; padding-block: 24px; }
		.step-content h3 { font-size: 22px; }
		.step-content p { font-size: 15px; }
	}

	@media (max-width: 480px) {
		.process-container { width: min(calc(100% - 2rem), 1170px); }
		.eyebrow { margin-bottom: 20px; font-size: 12px; }
		.process-intro { margin-bottom: 38px; }
		.process-step { grid-template-columns: 60px minmax(0, 1fr); gap: 14px; }
		.step-number { width: 60px; height: 60px; font-size: 24px; border-radius: 13px; }
		.step-content h3 { margin-bottom: 9px; font-size: 19px; }
		.step-content p { font-size: 14px; }
	}
</style>
