---
import { Image } from 'astro:assets';
import GHLLeadForm from '../components/GHLLeadForm.astro';
import portfolioImage from '../assets/portfolio.png';
---

<section id="request-quote" class="portfolio-section" aria-labelledby="portfolio-title">
	<div class="portfolio-container">
		<header class="portfolio-header">
			<p class="eyebrow">FREE PLUMBING ESTIMATE</p>
			<h2 id="portfolio-title">NEED A PLUMBER? GET A FREE QUOTE</h2>
		</header>

		<article class="featured-project">
			<figure class="project-image-wrap">
				<Image
					class="project-image"
					src={portfolioImage}
					alt="Plumber replacing a sink pipe beneath a kitchen cabinet"
					width={1672}
					height={941}
					widths={[640, 960, 1280, 1672]}
					sizes="(max-width: 800px) 100vw, min(100vw, 1480px)"
					loading="lazy"
				/>
			</figure>

			<div class="project-card">
				<h3>Need Plumbing Help?</h3>
				<p class="project-intro">Tell us what you need and we&apos;ll help you take the next step.</p>
				<GHLLeadForm />
			</div>
		</article>
	</div>
</section>

<style>
	.portfolio-section { background: white; color: var(--color-plombera-navy-950); }
	.portfolio-container { width: min(calc(100% - 2.5rem), 1480px); margin-inline: auto; padding-block: clamp(56px, 5vw, 72px) clamp(72px, 8vw, 112px); }
	.portfolio-header { margin: 0 auto clamp(52px, 5vw, 70px); text-align: center; }
	.eyebrow { display: inline-flex; width: fit-content; margin: 0 0 27px; padding: 6px 13px 5px; border: 1px solid var(--color-plombera-navy-950); border-radius: var(--radius-pill); font-family: var(--font-display); font-size: 15px; font-weight: 700; line-height: 1; text-transform: uppercase; }
	.portfolio-header h2 { max-width: 760px; margin: 0 auto; font-size: clamp(34px, 3.5vw, 52px); line-height: 0.98; letter-spacing: -0.035em; }
	.featured-project { position: relative; }
	.project-image-wrap { margin: 0; overflow: hidden; aspect-ratio: 1.64; background: var(--color-plombera-surface); }
	.project-image { display: block; width: 100%; height: 100%; object-fit: cover; }
	.project-card { position: absolute; z-index: 1; top: 5%; right: 8%; width: min(40%, 510px); padding: 34px 32px 28px; border-radius: var(--radius-card); background: white; box-shadow: var(--shadow-float); }
	.project-card h3 { margin: 0; font-size: clamp(24px, 1.9vw, 30px); line-height: 1.04; letter-spacing: -0.025em; }
	.project-intro { max-width: 360px; margin: 10px 0 20px; color: var(--color-plombera-muted); font-size: 14px; line-height: 1.4; }

	@media (max-width: 1100px) {
		.project-card { position: relative; top: auto; right: auto; width: auto; margin: -56px 28px 0; }
	}

	@media (max-width: 800px) {
		.portfolio-container { padding-block: 56px 76px; }
		.portfolio-header { margin-bottom: 38px; }
		.portfolio-header h2 { font-size: clamp(32px, 8vw, 44px); }
		.project-card { margin: -42px 14px 0; padding: 32px 24px 30px; }
	}

	@media (max-width: 480px) {
		.portfolio-container { width: min(calc(100% - 2rem), 1480px); }
		.eyebrow { margin-bottom: 20px; font-size: 12px; }
		.portfolio-header { margin-bottom: 32px; }
		.portfolio-header h2 { font-size: clamp(31px, 9vw, 40px); }
		.project-card { margin-inline: 8px; padding: 27px 20px 25px; }
		.project-card h3 { font-size: 22px; }
	}
</style>
