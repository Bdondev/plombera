---
const faqs = [
	{
		question: 'How often should I have my plumbing inspected?',
		answer: 'A regular inspection can help you spot leaks, worn fixtures, and other plumbing concerns before they become disruptive.',
	},
	{
		question: 'Why is my water pressure lower than usual?',
		answer: 'A partially closed valve, a clogged fixture, or an issue in the supply line can affect water pressure. A qualified plumber can help identify the cause.',
	},
	{
		question: 'How can I prevent clogged drains?',
		answer: 'Use drain screens, avoid putting grease or unsuitable materials down the drain, and address slow drainage before it becomes a blockage.',
	},
	{
		question: 'What should I do if a pipe starts leaking?',
		answer: 'Turn off the nearest shutoff valve if it is safe to do so, contain the water, and contact a plumber to assess the leak.',
	},
	{
		question: 'How do I know if my water heater needs attention?',
		answer: 'Changes in hot-water availability, unusual sounds, or visible moisture around the unit are good reasons to arrange an inspection.',
	},
	{
		question: 'Do you help with plumbing emergencies?',
		answer: 'Call the number below to discuss your plumbing concern and determine the appropriate next step.',
	},
];
---

<section id="faq" class="faq-section" aria-labelledby="faq-title">
	<div class="faq-container">
		<div class="faq-intro">
			<div>
				<p class="eyebrow">FAQ</p>
				<h2 id="faq-title">Have Questions? We’ve<br class="desktop-break" /> Got Answers</h2>
			</div>

			<aside class="contact-card" aria-labelledby="faq-contact-title">
				<h3 id="faq-contact-title">Still Have Questions? We’re<br class="desktop-break" /> Here To Help</h3>
				<div class="contact-actions">
					<a class="contact-cta" href="/#contact">Contact Us</a>
					<a class="contact-phone" href="tel:+15145550123" aria-label="Call Or Chat — Call Plombera at (514) 555-0123">
						<span class="phone-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
								<path d="M7.4 3.4 10 6.1 8.4 8.7a16 16 0 0 0 6.9 6.9l2.6-1.6 2.7 2.6-1.5 3.3c-.3.7-1.1 1-1.8.9C9.6 19.7 4.3 14.4 3.2 6.7c-.1-.7.2-1.5.9-1.8l3.3-1.5Z" />
							</svg>
						</span>
						<span class="phone-copy"><span>Call Or Chat</span><strong>(514) 555-0123</strong></span>
					</a>
				</div>
			</aside>
		</div>

		<div class="faq-list">
			{faqs.map((faq, index) => (
				<details class="faq-item" name="faq" open={index === 0}>
					<summary>
						<span>{faq.question}</span>
						<span class="faq-chevron" aria-hidden="true"></span>
					</summary>
					<p>{faq.answer}</p>
				</details>
			))}
		</div>
	</div>
</section>

<style>
	.faq-section {
		background: white;
		color: var(--color-plombera-navy-950);
	}

	.faq-container {
		display: grid;
		grid-template-columns: minmax(320px, 0.86fr) minmax(0, 1.14fr);
		gap: clamp(42px, 7.2vw, 105px);
		/* Match the How We Work section's desktop content container. */
		width: min(calc(100% - 2.5rem), 1170px);
		margin-inline: auto;
		padding-block: clamp(70px, 8vw, 112px) clamp(78px, 8vw, 115px);
	}

	.faq-intro {
		display: flex;
		min-height: 466px;
		flex-direction: column;
		justify-content: space-between;
	}

	.eyebrow {
		display: inline-flex;
		width: fit-content;
		margin: 0 0 23px;
		padding: 6px 10px 5px;
		border: 1px solid var(--color-plombera-navy-950);
		border-radius: var(--radius-pill);
		font-family: var(--font-display);
		font-size: 13px;
		font-weight: 700;
		line-height: 1;
		text-transform: uppercase;
	}

	.faq-intro h2 {
		max-width: 390px;
		margin: 0;
		font-size: clamp(34px, 3.35vw, 44px);
		line-height: 0.98;
		letter-spacing: -0.04em;
	}

	.contact-card {
		padding: 31px 27px 25px;
		border-radius: 12px;
		background: #f7f5ff;
	}

	.contact-card h3 {
		margin: 0;
		font-size: clamp(22px, 2vw, 27px);
		line-height: 1.15;
		letter-spacing: -0.035em;
	}

	.contact-actions {
		display: flex;
		align-items: center;
		gap: 13px;
		margin-top: 26px;
	}

	.contact-cta {
		display: inline-flex;
		min-height: 45px;
		align-items: center;
		justify-content: center;
		padding-inline: 20px;
		border-radius: var(--radius-pill);
		background: var(--color-plombera-yellow-400);
		box-shadow: 0 2px 0 var(--color-plombera-navy-950);
		color: var(--color-plombera-navy-950);
		font-size: 14px;
		font-weight: 800;
		text-decoration: none;
		white-space: nowrap;
	}

	.contact-cta:hover { background: var(--color-plombera-yellow-300); }

	.contact-phone {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		color: var(--color-plombera-navy-950);
		text-decoration: none;
	}

	.phone-icon {
		display: grid;
		width: 45px;
		height: 45px;
		flex: none;
		place-items: center;
		border-radius: 50%;
		background: var(--color-plombera-blue-600);
		color: white;
	}

	.phone-icon svg { width: 22px; height: 22px; }
	.phone-copy { display: grid; gap: 3px; white-space: nowrap; }
	.phone-copy span { color: #4f5d73; font-size: 12px; }
	.phone-copy strong { font-size: 14px; font-weight: 800; }

	.faq-list {
		display: grid;
		align-content: start;
		gap: 19px;
	}

	.faq-item {
		border: 1px solid #e7e7ec;
		border-radius: 7px;
		background: white;
		overflow: hidden;
	}

	.faq-item summary {
		display: flex;
		min-height: 50px;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 0 17px;
		cursor: pointer;
		list-style: none;
		font-family: var(--font-display);
		font-size: 14px;
		font-weight: 800;
		line-height: 1.15;
		text-transform: uppercase;
	}

	.faq-item summary::-webkit-details-marker { display: none; }
	.faq-chevron {
		width: 10px;
		height: 10px;
		flex: none;
		transform: translateY(-3px) rotate(45deg);
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transition: transform 160ms ease;
	}
	.faq-item[open] {
		border-color: var(--color-plombera-blue-600);
		background: var(--color-plombera-blue-600);
		color: white;
	}
	.faq-item[open] .faq-chevron {
		transform: translateY(3px) rotate(225deg);
	}
	.faq-item p {
		max-width: 510px;
		margin: -1px 36px 15px 17px;
		color: rgb(255 255 255 / 88%);
		font-size: 14px;
		line-height: 1.35;
	}

	.faq-item summary:focus-visible,
	.contact-cta:focus-visible,
	.contact-phone:focus-visible {
		outline: 3px solid var(--color-plombera-blue-500);
		outline-offset: 3px;
	}
	.faq-item[open] summary:focus-visible { outline-color: white; }

	@media (max-width: 800px) {
		.faq-container {
			display: block;
			width: min(calc(100% - 2.5rem), 1170px);
			padding-block: 72px 80px;
		}
		.faq-intro { min-height: 0; gap: 54px; }
		.faq-intro h2 { max-width: 500px; }
		.faq-list { margin-top: 48px; gap: 14px; }
	}

	@media (max-width: 480px) {
		.faq-container { width: min(calc(100% - 2rem), 1170px); padding-block: 60px 68px; }
		.eyebrow { margin-bottom: 19px; font-size: 12px; }
		.faq-intro h2 { font-size: 36px; }
		.contact-card { padding: 25px 20px 22px; }
		.contact-card h3 { font-size: 22px; }
		.contact-actions { align-items: flex-start; flex-wrap: wrap; margin-top: 23px; }
		.faq-list { margin-top: 42px; }
		.faq-item summary { min-height: 58px; padding-inline: 15px; font-size: 13px; }
		.faq-item p { margin: -1px 29px 15px 15px; font-size: 14px; }
		.desktop-break { display: none; }
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-chevron { transition-duration: 0.01ms; }
	}
</style>
