---
import { Image } from 'astro:assets';
import aboutOne from '../assets/about-1.png';
import aboutTwo from '../assets/about-2.png';
import aboutThree from '../assets/about-3.png';

const trustCards = [
	{
		image: aboutOne,
		metric: '5K+',
		label: 'Plumbing Completed',
		description: 'We use premium materials and proven techniques to ensure your plumbing stays reliable long after the complete.',
		alt: '',
	},
	{
		image: aboutTwo,
		metric: '99%',
		label: 'Customer Satisfaction',
		description: 'Our team is committed to the friendly service, expert workmanship, and complete transparency at every step.',
		alt: '',
	},
	{
		image: aboutThree,
		metric: '24/7',
		label: 'Emergency Support',
		description: 'With years of experience & a trusted team of licensed plumbers, we pride ourselves on providing fast solutions.',
		alt: '',
	},
];
---

<section id="about" class="about-section" aria-labelledby="about-title">
	<div class="about-container">
		<div class="about-intro">
			<p class="eyebrow">About Us</p>
			<div class="about-copy">
				<h2 id="about-title">
					<span class="heading-strong">That’s why we offer quick response times, affordable</span>
					{' '}<span class="heading-muted">pricing, and a team of skilled professionals who get the job done without the stress.</span>
				</h2>
				<a class="about-cta" href="/#contact">Learn More About Us</a>
			</div>
		</div>

		<div class="trust-grid" aria-label="Plombera service highlights">
			{trustCards.map((card) => (
				<article class="trust-card" aria-label={`${card.metric} ${card.label}`}>
					<div class="trust-summary">
						<Image src={card.image} alt={card.alt} width={118} height={118} loading="lazy" />
						<div class="trust-metric">
							<strong>{card.metric}</strong>
							<span>{card.label}</span>
						</div>
					</div>
					<p>{card.description}</p>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.about-section {
		border-top: 1px solid rgb(16 43 99 / 45%);
		background: white;
		color: var(--color-plombera-navy-950);
	}

	.about-container {
		width: min(calc(100% - 2.5rem), 1170px);
		margin-inline: auto;
		padding-block: clamp(74px, 7.2vw, 116px) clamp(76px, 8vw, 128px);
	}

	.about-intro {
		display: grid;
		grid-template-columns: minmax(180px, 1fr) minmax(0, 2.05fr);
		gap: clamp(32px, 5vw, 72px);
		align-items: start;
	}

	.eyebrow {
		display: inline-flex;
		width: fit-content;
		margin: 1px 0 0;
		padding: 4px 9px 3px;
		border: 1px solid var(--color-plombera-navy-950);
		border-radius: var(--radius-pill);
		font-family: var(--font-display);
		font-size: 11px;
		font-weight: 700;
		line-height: 1;
		text-transform: uppercase;
	}

	.about-copy h2 {
		max-width: 760px;
		margin: 0;
		font-size: clamp(28px, 3vw, 42px);
		line-height: 1.02;
		letter-spacing: -0.035em;
	}

	.heading-strong,
	.heading-muted {
		display: inline;
	}

	.heading-strong { color: var(--color-plombera-navy-950); }
	.heading-muted { color: #64748b; }

	.about-cta {
		display: inline-flex;
		min-height: 46px;
		align-items: center;
		justify-content: center;
		margin-top: 25px;
		padding-inline: 19px;
		border-radius: var(--radius-pill);
		background: var(--color-plombera-yellow-400);
		box-shadow: 0 2px 0 var(--color-plombera-navy-950);
		color: var(--color-plombera-navy-950);
		font-size: 13px;
		font-weight: 800;
		text-decoration: none;
	}

	.about-cta:hover { background: var(--color-plombera-yellow-300); }
	.about-cta:focus-visible { outline: 3px solid var(--color-plombera-blue-600); outline-offset: 4px; }

	.trust-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
		margin-top: clamp(54px, 6.2vw, 98px);
	}

	.trust-card {
		display: flex;
		min-height: 410px;
		flex-direction: column;
		justify-content: space-between;
		padding: 22px 24px 23px;
		border: 1px solid var(--color-plombera-line);
		border-radius: var(--radius-card);
		background: white;
	}

	.trust-summary {
		display: flex;
		align-items: center;
		gap: 23px;
	}

	.trust-summary img {
		display: block;
		width: 118px;
		height: 118px;
		flex: none;
		border-radius: 11px;
		object-fit: cover;
	}

	.trust-metric {
		display: grid;
		gap: 5px;
		min-width: 0;
		text-align: right;
	}

	.trust-metric strong {
		font-family: var(--font-display);
		font-size: clamp(28px, 2.5vw, 42px);
		font-weight: 800;
		line-height: 0.9;
		letter-spacing: -0.04em;
	}

	.trust-metric span {
		color: var(--color-plombera-muted);
		font-size: 13px;
		line-height: 1.15;
		white-space: nowrap;
	}

	.trust-card > p {
		margin: 0;
		padding-top: 20px;
		border-top: 1px solid var(--color-plombera-line);
		color: var(--color-plombera-muted);
		font-size: 15px;
		line-height: 1.38;
	}

	@media (max-width: 800px) {
		.about-container { padding-block: 64px 72px; }
		.about-intro { grid-template-columns: 1fr; gap: 24px; }
		.about-copy h2 { max-width: 620px; font-size: clamp(28px, 7vw, 38px); }
		.trust-grid { grid-template-columns: 1fr; margin-top: 52px; }
		.trust-card { min-height: 280px; }
	}

	@media (max-width: 480px) {
		.about-container { width: min(calc(100% - 2rem), 1170px); }
		.about-copy h2 { font-size: 31px; }
		.trust-card { min-height: 208px; padding: 16px; }
		.trust-summary img { width: 78px; height: 78px; }
		.trust-summary { gap: 14px; }
		.trust-metric strong { font-size: 30px; }
		.trust-metric span { font-size: 11px; }
	}
</style>
