---
import { Image } from 'astro:assets';
import heroBackground from '../assets/hero.png';
import heroPlumber from '../assets/hero-2.png';
---

<main id="main-content">
	<section class="hero" aria-labelledby="hero-title">
		<Image class="hero-background" src={heroBackground} alt="Plumber repairing pipes beneath a sink" width={1672} height={941} widths={[640, 960, 1280, 1672]} sizes="100vw" quality={70} loading="eager" fetchpriority="high" />
		<div class="hero-shade" aria-hidden="true"></div>
		<div class="hero-blue" aria-hidden="true"></div>
		<div class="hero-navy" aria-hidden="true"></div>
		<Image class="hero-plumber" src={heroPlumber} alt="" width={1122} height={1402} widths={[480, 640, 960]} sizes="(max-width: 600px) 72vw, 53vw" loading="eager" />
		<div class="hero-content">
			<p class="eyebrow">Plumbing emergencies? We fix fast!</p>
			<h1 id="hero-title">Trusted Local<br />Plumbers Ready<br />When You Need Us</h1>
			<p class="hero-description">Got a leak, burst pipe, or clogged drain? Our emergency plumbers are ready 24/7 to restore your comfort and prevent costly damage.</p>
			<a class="hero-cta" href="/#contact">Schedule A Plumber</a>
		</div>
	</section>
</main>

<style>
	.hero { position: relative; isolation: isolate; width: 100%; height: clamp(680px, 69.72vw, 1004px); overflow: hidden; border-radius: 13px 13px 0 0; background: var(--color-plombera-navy-950); }
	.hero-background { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center center; }
	.hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(9 25 48 / 16%), transparent 55%); }
	.hero-blue { position: absolute; inset: 0; background: var(--color-plombera-blue-600); clip-path: polygon(0 21%, 68% 67%, 36% 100%, 0 100%); }
	.hero-navy { position: absolute; inset: 0; background: var(--color-plombera-navy-950); clip-path: polygon(100% 44%, 100% 100%, 58% 100%); }
	.hero-plumber { position: absolute; z-index: 2; right: -0.5%; bottom: -2%; width: 53%; height: auto; max-height: 84%; object-fit: contain; object-position: bottom right; }
	.hero-content { position: absolute; z-index: 3; top: 48%; left: max(calc((100% - 1170px) / 2), 9.2%); width: min(50%, 640px); color: white; }
	.eyebrow { display: inline-block; margin: 0 0 19px; padding: 5px 10px 4px; border: 1px solid rgb(255 255 255 / 85%); border-radius: var(--radius-pill); font-family: var(--font-display); font-size: 15px; font-weight: 700; line-height: 1; text-transform: uppercase; }
	h1 { margin: 0; color: white; font-size: clamp(52px, 5vw, 72px); line-height: 1.16; letter-spacing: -0.025em; }
	.hero-description { max-width: 590px; margin: 10px 0 28px; color: rgb(255 255 255 / 89%); font-size: 17px; line-height: 1.45; }
	.hero-cta { display: inline-flex; min-height: 54px; align-items: center; justify-content: center; padding: 0 23px; border-radius: var(--radius-pill); background: var(--color-plombera-yellow-400); color: var(--color-plombera-navy-950); font-size: 16px; font-weight: 800; text-decoration: none; }
	.hero-cta:hover { background: var(--color-plombera-yellow-300); }
	.hero-cta:focus-visible { outline: 3px solid white; outline-offset: 4px; }
	/* French copy is longer, so give it a little more room at larger breakpoints. */
	html[lang="fr"] .hero-content { width: min(55%, 680px); }
	html[lang="fr"] h1 { font-size: clamp(46px, 4.4vw, 66px); letter-spacing: -0.045em; }
	@media (max-width: 1050px) {
		.hero-content { top: 45%; left: 6%; width: 56%; }
		h1 { font-size: clamp(48px, 5.4vw, 64px); }
		.hero-description { font-size: 15px; }
		html[lang="fr"] .hero-content { top: 41%; width: 61%; }
		html[lang="fr"] h1 { font-size: clamp(40px, 5vw, 58px); }
	}
	@media (max-width: 600px) {
		.hero { height: 1080px; border-radius: 0; }
		.hero-background { height: 400px; object-position: 36% center; }
		.hero-shade { height: 400px; }
		.hero-blue { clip-path: polygon(0 28%, 100% 38%, 100% 100%, 0 100%); }
		.hero-navy { display: none; }
		.hero-plumber { right: -3%; bottom: -1%; width: 72%; max-height: none; }
		.hero-content { top: 385px; left: 6%; width: 88%; }
		.eyebrow { margin-bottom: 16px; font-size: 12px; }
		h1 { font-size: clamp(42px, 10vw, 52px); line-height: 1.04; }
		.hero-description { max-width: 340px; margin: 14px 0 22px; font-size: 15px; line-height: 1.4; }
		.hero-cta { min-height: 48px; padding-inline: 19px; font-size: 14px; }
		html[lang="fr"] .hero-content { top: 385px; width: 88%; }
		html[lang="fr"] h1 { font-size: clamp(38px, 9.2vw, 50px); }
	}
</style>
