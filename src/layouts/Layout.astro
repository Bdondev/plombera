---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Plombera | Plumbing Services',
	description = 'Plombera provides professional plumbing services, emergency repairs, leak detection, water heater service, and free quotes.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://plombera.vercel.app');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<Footer />
	</body>
</html>

