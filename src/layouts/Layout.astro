		'Lead follow-up': 'Suivi des demandes',
		'If you contact Plombera by phone or another available contact method, information you choose to share may be used to respond to your request and provide customer support. If the quote form is activated, it may collect your name, email address, phone number, and the plumbing service you select.': 'Si vous communiquez avec Plombera par téléphone ou par un autre moyen disponible, les renseignements que vous choisissez de partager peuvent être utilisés pour répondre à votre demande et vous offrir du soutien. Si le formulaire de soumission est activé, il peut recueillir votre nom, votre adresse courriel, votre numéro de téléphone et le service de plomberie sélectionné.',
		'Links or phone actions may take you to services outside this website. Their privacy practices are governed by their own policies, so review those policies before sharing information. If a GoHighLevel form is enabled, GoHighLevel will process submitted lead information as a third-party service provider under the business’s account configuration.': 'Les liens ou les actions téléphoniques peuvent vous diriger vers des services externes. Leurs pratiques de confidentialité sont régies par leurs propres politiques; consultez-les avant de partager des renseignements. Si un formulaire GoHighLevel est activé, GoHighLevel traitera les renseignements soumis comme fournisseur de services tiers selon la configuration du compte de l’entreprise.',
		'Information submitted through a quote form may be used to respond to your request and communicate with you about that request. The business should review and confirm its retention, consent, and communication practices before activating the form for production use.': 'Les renseignements transmis par un formulaire de soumission peuvent servir à répondre à votre demande et à communiquer avec vous à ce sujet. L’entreprise devrait réviser et confirmer ses pratiques de conservation, de consentement et de communication avant d’activer le formulaire en production.',
		'Your questions': 'Vos questions',
		'All Rights Reserved': 'Tous droits réservés',
	};

	const reverseTranslations = Object.fromEntries(Object.entries(translations).map(([english, french]) => [french, english]));
	const translateValue = (value, language) => {
		const dictionary = language === 'fr' ? translations : reverseTranslations;
		const trimmed = value.trim();
		if (trimmed.startsWith('© Copyright ') && trimmed.includes(' – Plombera. ')) {
			const year = trimmed.match(/^© Copyright (\\d{4})/)?.[1] || new Date().getFullYear();
			return value.replace(trimmed, language === 'fr' ? `© Copyright ${year} – Plombera. Tous droits réservés` : `© Copyright ${year} – Plombera. All Rights Reserved`);
		}
		const translated = dictionary[trimmed];
		return translated ? value.replace(trimmed, translated) : value;
	};

	const translatePage = (language) => {
		document.documentElement.lang = language === 'fr' ? 'fr' : 'en';
		const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
		const textNodes = [];
		while (walker.nextNode()) textNodes.push(walker.currentNode);
		textNodes.forEach((node) => {
			if (!node.parentElement || ['SCRIPT', 'STYLE'].includes(node.parentElement.tagName)) return;
			node.nodeValue = translateValue(node.nodeValue, language);
		});
		document.querySelectorAll('[aria-label], [alt], [placeholder]').forEach((element) => {
			for (const attribute of ['aria-label', 'alt', 'placeholder']) {
				if (element.hasAttribute(attribute)) element.setAttribute(attribute, translateValue(element.getAttribute(attribute), language));
			}
		});
		document.querySelectorAll('[data-language-toggle]').forEach((button) => {
			button.setAttribute('aria-pressed', language === 'fr' ? 'true' : 'false');
			button.setAttribute('aria-label', language === 'fr' ? 'EN — Passer à l’anglais' : 'FR — Switch to French');
			const label = button.querySelector('[data-language-label]');
			if (label) label.textContent = language === 'fr' ? 'EN' : 'FR';
		});
	};

	const initialLanguage = localStorage.getItem('plombera-language') || 'en';
	if (initialLanguage === 'fr') translatePage('fr');
	document.querySelectorAll('[data-language-toggle]').forEach((button) => {
		button.addEventListener('click', () => {
			const language = document.documentElement.lang === 'fr' ? 'en' : 'fr';
			localStorage.setItem('plombera-language', language);
			translatePage(language);
		});
	});
</script>

