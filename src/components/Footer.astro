---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const currentYear = new Date().getFullYear();

const quickLinks = [
	{ label: 'Home', href: '/' },
	{ label: 'Services', href: '/#services' },
	{ label: 'About Us', href: '/#about' },
	{ label: 'Our Blog', href: '/#blog' },
	{ label: 'Contact', href: '/#contact' },
	{ label: 'FAQs', href: '/#faq' },
];

const socialLinks = [
	{ label: 'Facebook', icon: 'facebook' },
	{ label: 'LinkedIn', icon: 'linkedin' },
	{ label: 'YouTube', icon: 'youtube' },
	{ label: 'X', icon: 'x' },
];

const hours = [
	{ day: 'Mon – Fri:', value: 'Call for hours' },
	{ day: 'Sat:', value: 'Call for hours' },
	{ day: 'Sun:', value: 'Call for hours' },
];
---

<footer class="site-footer">
	<div class="footer-container">
		<div class="footer-grid">
			<div class="footer-brand-column">
				<a class="footer-logo" href="/" aria-label="Plombera home">
					<Image src={logo} alt="Plombera" width={207} height={69} loading="lazy" />
				</a>
				<p class="footer-description">Plumbing services for homes and businesses, with practical help when you need it.</p>
				<div class="social-links" aria-label="Plombera social media links">
					{socialLinks.map((social) => (
						<a class="social-link" href="/#contact" aria-label={`${social.icon === 'linkedin' ? 'in — ' : ''}${social.label} contact link`}>
							{social.icon === 'facebook' && <span aria-hidden="true" class="facebook-icon">f</span>}
							{social.icon === 'linkedin' && <span aria-hidden="true" class="linkedin-icon">in</span>}
							{social.icon === 'youtube' && (
								<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
									<path d="M21.3 7.2a2.7 2.7 0 0 0-1.9-1.9C17.7 4.8 12 4.8 12 4.8s-5.7 0-7.4.5a2.7 2.7 0 0 0-1.9 1.9c-.5 1.7-.5 4.8-.5 4.8s0 3.1.5 4.8a2.7 2.7 0 0 0 1.9 1.9c1.7.5 7.4.5 7.4.5s5.7 0 7.4-.5a2.7 2.7 0 0 0 1.9-1.9c.5-1.7.5-4.8.5-4.8s0-3.1-.5-4.8ZM10.2 15.4V8.6l5.9 3.4-5.9 3.4Z" />
								</svg>
							)}
							{social.icon === 'x' && <span aria-hidden="true" class="x-icon">X</span>}
						</a>
					))}
				</div>
			</div>

			<nav class="footer-column" aria-label="Footer navigation">
				<h2>Quick Links</h2>
				<ul>
					{quickLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
				</ul>
			</nav>

			<div class="footer-column contact-column">
				<h2>Contact Us</h2>
				<ul class="contact-list">
					<li>
						<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
							<path d="M7.4 3.4 10 6.1 8.4 8.7a16 16 0 0 0 6.9 6.9l2.6-1.6 2.7 2.6-1.5 3.3c-.3.7-1.1 1-1.8.9C9.6 19.7 4.3 14.4 3.2 6.7c-.1-.7.2-1.5.9-1.8l3.3-1.5Z" />
						</svg>
						<a href="tel:+15145550123" aria-label="Call Plombera at (514) 555-0123">(514) 555-0123</a>
					</li>
					<li class="contact-note">
						<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 21s6-5.3 6-11a6 6 0 1 0-12 0c0 5.7 6 11 6 11Z" /><circle cx="12" cy="10" r="2" />
						</svg>
						<span>1234 Rue des Plombiers,<br />Montréal, QC H0H 0H0</span>
					</li>
					<li class="contact-note">
						<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
							<rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" />
						</svg>
						<a href="mailto:info@plombera.com">info@plombera.com</a>
					</li>
				</ul>
			</div>

			<div class="footer-column hours-column">
				<h2>Working Hours</h2>
				<div class="hours-card" aria-label="Working hours require confirmation">
					{hours.map((row) => (
						<div class="hours-row"><strong>{row.day}</strong><span>{row.value}</span></div>
					))}
				</div>
			</div>
		</div>

		<div class="footer-bottom">
			<p>© Copyright {currentYear} – Plombera. All Rights Reserved</p>
			<a href="/privacy-policy">Privacy Policy</a>
		</div>
		<p class="footer-wordmark" aria-hidden="true">PLOMBERA</p>
	</div>
</footer>

<style>
	.site-footer {
		background: #f6f6f6;
		color: var(--color-plombera-navy-950);
	}

	.footer-container {
		width: min(calc(100% - 2.5rem), 1170px);
		margin-inline: auto;
		padding-top: clamp(58px, 7vw, 84px);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.3fr 0.84fr 1.04fr 1.2fr;
		gap: clamp(28px, 4vw, 64px);
	}

	.footer-logo { display: inline-flex; }
	.footer-logo img { display: block; width: clamp(156px, 14vw, 207px); height: auto; }
	.footer-description {
		max-width: 260px;
		margin: 16px 0 0;
		color: #5f6878;
		font-size: 14px;
		line-height: 1.35;
	}

	.footer-column h2 {
		margin: 3px 0 22px;
		font-size: 17px;
		line-height: 1;
		letter-spacing: -0.025em;
	}

	.footer-column ul { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
	.footer-column a,
	.footer-column li,
	.footer-description,
	.footer-bottom { color: #5f6878; font-size: 14px; line-height: 1.35; }
	.footer-column a { text-decoration: none; }
	.footer-column a:hover { color: var(--color-plombera-blue-600); }

	.social-links {
		display: flex;
		gap: 10px;
		margin-top: 42px;
	}

	.social-link {
		display: grid;
		width: 35px;
		height: 35px;
		place-items: center;
		border-radius: 50%;
		background: white;
		color: var(--color-plombera-navy-950);
		text-decoration: none;
	}
	.social-link:hover,
	.social-link:focus-visible { background: var(--color-plombera-yellow-300); }
	.social-link svg { width: 17px; height: 17px; }
	.facebook-icon { font-size: 21px; font-weight: 800; line-height: 1; }
	.linkedin-icon { font-size: 16px; font-weight: 800; letter-spacing: -0.08em; }
	.x-icon { font-family: Arial, sans-serif; font-size: 17px; }

	.contact-list { gap: 14px !important; }
	.contact-list li { display: flex; align-items: flex-start; gap: 10px; }
	.contact-list svg { width: 18px; height: 18px; flex: none; color: #5f6878; }
	.contact-list a { color: #5f6878; }
	.contact-note { color: #5f6878; }

	.hours-card {
		padding: 11px 17px;
		border-radius: 10px;
		background: white;
		box-shadow: 0 4px 14px rgb(16 43 99 / 3%);
	}
	.hours-row {
		display: flex;
		min-height: 36px;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		border-bottom: 1px solid #e6e7eb;
		color: #5f6878;
		font-size: 12px;
		white-space: nowrap;
	}
	.hours-row:last-child { border-bottom: 0; }
	.hours-row strong { color: var(--color-plombera-navy-950); font-size: 12px; }

	.footer-bottom {
		display: flex;
		min-height: 62px;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		margin-top: 49px;
		border-top: 1px solid #dedfe3;
	}
	.footer-bottom p { margin: 0; }
	.footer-bottom a { color: #5f6878; text-decoration: none; }
	.footer-bottom a:hover { color: var(--color-plombera-blue-600); }
	.footer-wordmark {
		width: 100%;
		margin: 34px 0 0;
		color: var(--color-plombera-navy-950);
		font-family: var(--font-display);
		font-size: clamp(92px, 16.7vw, 220px);
		font-weight: 900;
		line-height: 0.84;
		letter-spacing: -0.095em;
		text-align: center;
		white-space: nowrap;
	}

	a:focus-visible { outline: 3px solid var(--color-plombera-blue-600); outline-offset: 4px; }

	@media (max-width: 900px) {
		.footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 48px; }
		.footer-brand-column { grid-column: span 2; }
		.footer-description { max-width: 390px; }
		.social-links { margin-top: 25px; }
	}

	@media (max-width: 600px) {
		.footer-container { width: min(calc(100% - 2rem), 1170px); padding-top: 55px; }
		.footer-grid { display: flex; flex-direction: column; gap: 35px; }
		.footer-column h2 { margin-bottom: 17px; }
		.footer-bottom { margin-top: 39px; min-height: 67px; }
		.footer-wordmark {
			margin: 30px 0 10px;
			font-size: min(15.5vw, 220px);
			line-height: 0.9;
		}
	}
</style>
